{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talleyrand:discovery-record:1.0.0",
  "title": "Talleyrand Discovery Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "protocol", "inquiry_id", "board_frozen_before_reading", "horus_source_selection_independent", "observations", "certification"],
  "properties": {
    "record_type": {"const": "talleyrand_discovery_record"},
    "protocol": {"const": "TAL-DISCOVERY-001"},
    "inquiry_id": {"type": "string", "minLength": 1},
    "board_frozen_before_reading": {"const": true},
    "horus_source_selection_independent": {"const": true},
    "certification": {"const": "NONE_SELF_CERTIFICATION_PROHIBITED"},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "support": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ref", "independence_group", "source_type"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "independence_group": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["PAGE_IMAGE_PRIMARY", "PRIMARY_TRANSCRIPTION", "DIRECT_WITNESS", "ATTRIBUTED_REPORT", "SELF_TESTIMONY", "RUMOR", "EDITORIAL_TRANSMISSION", "DERIVATIVE_ACCOUNT"]}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "proposition", "evidence_class", "support", "channel", "corroboration_state", "audience", "disclosure_state", "suppression", "technical_jurisdiction", "source_absence", "action_link"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "proposition": {"type": "string", "minLength": 1},
        "evidence_class": {"enum": ["DF", "HT", "SI", "WH", "UU", "V", "ED-PRIMARY"]},
        "support": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/support"}},
        "channel": {
          "type": "object", "additionalProperties": false,
          "required": ["origin", "immediate_sender", "intermediaries", "receiver", "access_state", "formality"],
          "properties": {
            "origin": {"type": "string", "minLength": 1},
            "immediate_sender": {"type": "string", "minLength": 1},
            "intermediaries": {"type": "array", "items": {"type": "string"}},
            "receiver": {"type": "string", "minLength": 1},
            "access_state": {"type": "string", "minLength": 1},
            "formality": {"type": "string", "minLength": 1}
          }
        },
        "corroboration_state": {"enum": ["UNCORROBORATED", "PARTIALLY_CORROBORATED", "CORROBORATED", "CONTRADICTED"]},
        "audience": {
          "type": "object", "additionalProperties": false,
          "required": ["immediate", "secondary", "true_audience_claim", "basis_source_refs"],
          "properties": {
            "immediate": {"type": "string", "minLength": 1},
            "secondary": {"type": "array", "items": {"type": "string"}},
            "true_audience_claim": {"type": "boolean"},
            "basis_source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "disclosure_state": {"enum": ["PUBLIC", "FORMAL", "CONFIDENTIAL", "PRIVATE", "WITHHELD", "SELECTIVELY_DISCLOSED", "NOT_YET_DISCLOSED"]},
        "suppression": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "mechanism_source_refs"],
          "properties": {
            "state": {"enum": ["NONE", "ALLEGED", "DOCUMENTED"]},
            "mechanism_source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "technical_jurisdiction": {
          "type": "object", "additionalProperties": false,
          "required": ["requires_specialist", "competence_source_refs"],
          "properties": {
            "requires_specialist": {"type": "boolean"},
            "competence_source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "source_absence": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "negative_claim"],
          "properties": {
            "state": {"enum": ["NONE", "NOT_SEARCHED", "SEARCHED_NOT_FOUND", "SOURCE_EXISTS_NOT_ACQUIRED", "SOURCE_ACQUIRED_INCOMPLETE", "DOCUMENTED_ABSENCE"]},
            "negative_claim": {"type": "boolean"},
            "scope": {"type": ["string", "null"]}
          }
        },
        "action_link": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "could_change"],
          "properties": {
            "kind": {"enum": ["JUDGMENT", "DEED", "QUERY", "DECISION", "ARCHIVE_ONLY"]},
            "ref": {"type": ["string", "null"]},
            "could_change": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
